{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://your-domain.vercel.app"
  },
  "crons": [
    {
      "path": "/api/orders/auto-release-delivery",
      "schedule": "0 6 * * *"
    }
  ]
}
