// firestore.rules
// ─── FIRESTORE SECURITY RULES — PRODUCTION ──────────────────────
// All rules default to DENY. Only listed paths are open.
// isPremium check is used by AI features.
// Subscriptions are write-locked — only server (Admin SDK) can write.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────
    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    function isSeller() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "seller";
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function ownsShop(shopId) {
      return isAuth() &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    function isPremium() {
      return isAuth() &&
        get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.plan
          in ["premium", "business"] &&
        get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.status
          == "active";
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ── Shops ────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read:   if true;
      allow create: if isSeller() && request.resource.data.ownerId == request.auth.uid;
      allow update: if ownsShop(shopId);
      allow delete: if ownsShop(shopId);
    }

    // ── Products ─────────────────────────────────────────────────
    match /products/{productId} {
      allow read:   if true;
      allow create: if isAuth() && ownsShop(request.resource.data.shopId);
      allow update: if isAuth() && ownsShop(resource.data.shopId);
      allow delete: if isAuth() && ownsShop(resource.data.shopId);
    }

    // ── Orders ───────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid ||
        ownsShop(resource.data.shopId)
      );
      allow create: if isAuth() && request.resource.data.buyerId == request.auth.uid;
      // Seller can update status — but not change amount, shop, or buyer
      allow update: if isAuth() && ownsShop(resource.data.shopId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["total", "subtotal", "shopId", "buyerId"]);
      allow delete: if false;
    }

    // ── Conversations ─────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read:   if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participants;
        allow create: if isAuth() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Subscriptions — SERVER WRITE ONLY ────────────────────────
    // Prevents users from upgrading themselves for free.
    match /subscriptions/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false; // Only Firebase Admin SDK (server-side) may write
    }

    // ── Notifications ─────────────────────────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read:          if isOwner(uid);
      allow update:        if isOwner(uid); // Mark as read
      allow create, delete: if false;       // Server only
    }

    // ── Analytics — SERVER WRITE ONLY ────────────────────────────
    match /analytics/{shopId} {
      allow read:  if ownsShop(shopId);
      allow write: if false;
    }

    // ── Reviews ───────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && resource.data.authorId == request.auth.uid;
      allow delete: if false;
    }

    // ── Livestreams ───────────────────────────────────────────────
    match /livestreams/{streamId} {
      allow read:   if true;
      allow create: if isSeller() && ownsShop(request.resource.data.shopId);
      allow update: if ownsShop(resource.data.shopId);
      allow delete: if ownsShop(resource.data.shopId);
    }

    // ── Classifieds (Kijiji-style listings) ─────────────────────────
    match /classifieds/{listingId} {
      allow read:   if true;   // public — must work for logged-out visitors clicking shared links
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // ── Standalone food listings ──────────────────────────────────
    match /foodListings/{listingId} {
      allow read:   if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // ── Saved / favourite listings ──────────────────────────────────
    match /favorites/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Seller ratings ──────────────────────────────────────────────
    match /sellerRatings/{sellerId}/reviews/{reviewId} {
      allow read:   if true;
      allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.reviewerId == request.auth.uid;
    }

    // ── Insurance requests (buyer leads) ───────────────────────────
    match /insuranceRequests/{requestId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      allow update: if request.auth != null;  // brokers mark contacted, status updates
      allow delete: if request.auth != null && resource.data.buyerId == request.auth.uid;
    }

    // ── Insurance brokers (directory + applications) ────────────────
    match /insuranceBrokers/{brokerId} {
      allow read:   if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── Fallback: deny everything else ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
