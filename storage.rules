// storage.rules
// ─── FIREBASE STORAGE SECURITY RULES ────────────────────────────
// Last updated: 2026-06-08 — no expiry, permanent rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile photos ───────────────────────────────────────────
    // Path: /users/{uid}/...
    match /users/{uid}/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024    // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Shop assets (logo, banner) ───────────────────────────────
    // Path: /shops/{shopId}/...
    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024   // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Product images ───────────────────────────────────────────
    // Path: /products/{productId}/...
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024   // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Classified ad images ──────────────────────────────────────
    // Path: /classifieds/{listingId}/...
    match /classifieds/{listingId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024   // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Food listing images ──────────────────────────────────────
    // Path: /foodListings/{userId}/...
    match /foodListings/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024   // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Resumes (AI-generated, server-uploaded via Admin SDK) ──────
    // Path: /resumes/{userId}/...
    match /resumes/{userId}/{allPaths=**} {
      allow read:  if true;   // employers need to view applicant resumes
      allow write: if false;  // only written server-side via Admin SDK
    }

    // ── Job application resume uploads ──────────────────────────────
    // Path: /applications/{userId}/...
    match /applications/{userId}/{allPaths=**} {
      allow read: if true;   // employer needs to view; gate via app-level checks
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024   // 10MB max
                   && (request.resource.contentType == 'application/pdf'
                      || request.resource.contentType.matches('application/.*word.*'));
    }

    // ── Status / story photos & videos ───────────────────────────
    // Path: /status/{uid}/...
    match /status/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024   // 50MB for video
                   && (request.resource.contentType.matches('image/.*')
                      || request.resource.contentType.matches('video/.*'));
    }

    // ── Livestream thumbnails ─────────────────────────────────────
    // Path: /livestreams/{streamId}/...
    match /livestreams/{streamId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Chat media (LinkUp Chat shared Firebase) ──────────────────
    // Path: /chat/{roomId}/...
    match /chat/{roomId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024   // 25MB max
                   && (request.resource.contentType.matches('image/.*')
                      || request.resource.contentType.matches('video/.*')
                      || request.resource.contentType.matches('audio/.*'));
    }

    // ── Room photos ───────────────────────────────────────────────
    // Path: /rooms/{userId}/...
    match /rooms/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024    // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Prediction images ─────────────────────────────────────────
    match /predictions/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Default: deny ────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
